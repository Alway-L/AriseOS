#!/bin/bash
set -u
dir=${1:?usage: droiddeck-appimage-run <imported AppImage directory> [args...]}
shift
export APPDIR=$dir/app
unset APPIMAGE
export ARGV0=$(cat "$dir/name" 2>/dev/null || basename "$dir")
if [ ! -x "$APPDIR/AppRun" ]; then
  echo "droiddeck-appimage-run: $APPDIR/AppRun is missing; import the AppImage again" >&2
  exit 127
fi
export MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 MOZ_DISABLE_UTILITY_SANDBOX=1
export MOZ_SHM_NO_SEALS=1
if [ -s /etc/ld.so.preload ]; then
  preload=$(tr -s '\n' ':' < /etc/ld.so.preload)
  export LD_PRELOAD="${preload%:}${LD_PRELOAD:+:$LD_PRELOAD}" SHARUN_ALLOW_LD_PRELOAD=1
fi
flags=()
if [ -n "$(find -H "$APPDIR" -maxdepth 4 \( -name chrome-sandbox -o -name chrome_100_percent.pak -o -name v8_context_snapshot.bin \) -print -quit 2>/dev/null)" ]; then
  flags+=(--no-sandbox)
  if [ -n "${DISPLAY:-}" ]; then
    export XDG_SESSION_TYPE=x11
    unset WAYLAND_DISPLAY
    flags+=(--ozone-platform=x11)
  fi
fi
qt=$(cat "$dir/qt" 2>/dev/null)
case $qt in wayland|xcb) ;; *) qt=auto ;; esac
wayland=${GAMESCOPE_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY:-}}
if [ "$qt" = auto ] && [ -n "$wayland" ]; then
  bundled=$(find "$APPDIR" -maxdepth 6 \( -name 'libQt6Quick.so.6*' -o -name libvulkan.so.1 -o -name 'libqwayland*.so' \) -printf '%f\n' 2>/dev/null)
  if grep -q '^libQt6Quick\.so\.6' <<<"$bundled"; then
    if grep -q '^libqwayland' <<<"$bundled" \
       && { grep -qx libvulkan.so.1 <<<"$bundled" || grep -qs QVulkanInstance "$APPDIR"/usr/bin/* "$APPDIR"/bin/*; }; then
      qt=wayland
    else
      echo "== appimage: Qt Quick without Vulkan or Qt's Wayland plugin stays on X11 ($(tr '\n' ' ' <<<"$bundled"))"
    fi
  fi
fi
if [ "$qt" = wayland ] && [ -n "$wayland" ]; then
  export QT_QPA_PLATFORM='wayland;xcb' WAYLAND_DISPLAY=$wayland SDL_VIDEODRIVER=wayland XDG_SESSION_TYPE=wayland
  [ "$wayland" = "${GAMESCOPE_WAYLAND_DISPLAY:-}" ] && export QT_WAYLAND_DISABLE_WINDOWDECORATION=1 DISABLE_GAMESCOPE_WSI=1
elif [ "$qt" = xcb ] && [ -n "${DISPLAY:-}" ]; then
  export QT_QPA_PLATFORM=xcb
fi
fex=$(cat "$dir/fex" 2>/dev/null)
case $fex in on|off) ;; *) fex=auto ;; esac
run=("$APPDIR/AppRun")
if [ -x /usr/local/bin/droiddeck-fex ]; then
  case $fex:$(cat "$dir/arch" 2>/dev/null) in
    auto:x86_64|auto:i386) run=(/usr/local/bin/droiddeck-fex run --mode on -- "$APPDIR/AppRun") ;;
    auto:arm64) ;;
    *) run=(/usr/local/bin/droiddeck-fex run --mode "$fex" --for "$APPDIR" -- "$APPDIR/AppRun") ;;
  esac
fi
# AriseOS: Eden-family emulators (Orchid, Eglantine, Lichii; they ship eden-cli) re-run themselves at start
# to test Vulkan. That child did not find the AppImage's bundled libraries (libQt6Charts...), died, and the
# emulator then reported "broken Vulkan" and fell back to OpenGL. The program (and so that child) gets the
# bundled library folder; set only on the program, so dbus-run-session and other system tools started before
# it keep the system's libraries (an ARM64 AppImage's own libdbus broke dbus-run-session).
if [ -e "$APPDIR/usr/bin/eden-cli" ] && [ -d "$APPDIR/usr/lib" ]; then
  eden_env=("LD_LIBRARY_PATH=$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}")
  # Orchid, Lichii and Lichii Frizti all keep their shader/pipeline cache in ~/.cache/eden, so one emulator
  # loaded pipelines another build (or an NCE try) had written, and games hung at "Launching..." or at
  # shaders 12/14. Each emulator gets its own cache folder; keys, firmware, saves and settings stay shared.
  eden_cache=${HOME:-/root}/.cache/arise/$(basename "$dir")
  mkdir -p "$eden_cache" 2>/dev/null && eden_env+=("XDG_CACHE_HOME=$eden_cache")
  # Native ARM64 builds get a small preload (source: tools/linuxfs/arise/ariseeden.c): their log (eden_log.txt),
  # otherwise flushed only on errors, is written line by line; and the 256 GiB address range they reserve at
  # boot is held for them from the start (ARISE_RESERVE_VA), since by the time a game started every place they
  # try was taken (mmap ENOMEM) and the game hung. x86-64 builds through FEX keep the old behaviour.
  if [ "$(cat "$dir/arch" 2>/dev/null)" = arm64 ]; then
    # On the phone the GPU's memory is the phone's RAM: Ocarina of Time loading its first area pushed Orchid to
    # ~6 GiB plus 4 GiB of swap and Android ended AriseOS (LOW_MEMORY). The texture cache starts evicting at
    # 1 GiB (hard limit 1.75 GiB), and glibc keeps 2 malloc arenas instead of one per busy thread (60+), which
    # held freed memory. Set any of them to override. (384/768 MiB was too small once guest memory went to a
    # file: Ocarina's first area needs ~1.8 GiB of textures, so every frame ran an emergency collection and
    # re-uploaded what it had just freed, and the game ran at 0-1 fps. 1.5/2.5 GiB then held ~3.9 GiB of GPU
    # memory, which Android cannot reclaim, so it evicted the guest memory file instead and the emulator
    # threads read ~450 pages a second back from storage. 1 GiB / 1.75 GiB keeps the first area's ~1.8 GiB
    # below the emergency line, which is 1.5x the critical size.)
    eden_env+=("EDEN_NX2_TC_EXPECTED_MIB=${EDEN_NX2_TC_EXPECTED_MIB:-1024}" "EDEN_NX2_TC_CRITICAL_MIB=${EDEN_NX2_TC_CRITICAL_MIB:-1792}"
               "MALLOC_ARENA_MAX=${MALLOC_ARENA_MAX:-2}")
    preload=$dir/.arise-eden-5.so
    [ -s "$preload" ] || { printf '%s' '' | base64 -d | gzip -dc > "$preload.tmp" && mv -f "$preload.tmp" "$preload"; } 2>/dev/null
    rm -f "$dir/.arise-logflush-1.so" "$dir/.arise-eden-2.so" "$dir/.arise-eden-3.so" "$dir/.arise-eden-4.so"
    # Holding the 256 GiB range (ARISE_RESERVE_VA=1) is off: the emulator never took the held block, which then
    # only cost address space. AriseOS's own builds of Orchid and Lichii Frizti fall back to a kernel-chosen place.
    [ -s "$preload" ] && eden_env+=("LD_PRELOAD=$preload${LD_PRELOAD:+:$LD_PRELOAD}")
  fi
  run=(env "${eden_env[@]}" "${run[@]}")
fi
# AriseOS diagnostics for Eden-family emulators: Switch 2 games need a 12 GiB host memory mapping, which failed
# (mmap ENOMEM) in this runtime. Record what the kernel allows, so the cause can be read from the session log.
if [ -e "$APPDIR/usr/bin/eden-cli" ] && command -v python3 >/dev/null 2>&1; then
  python3 - <<'PY' 2>&1 | sed 's/^/== memory: /'
import mmap, os
def read(p):
    try:
        return open(p).read().strip()
    except OSError as e:
        return "unreadable (%s)" % e.strerror
print("overcommit_memory=%s overcommit_ratio=%s max_map_count=%s" % (read("/proc/sys/vm/overcommit_memory"),
      read("/proc/sys/vm/overcommit_ratio"), read("/proc/sys/vm/max_map_count")))
info = dict(l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l)
print("MemTotal=%s SwapTotal=%s CommitLimit=%s Committed_AS=%s" % tuple(info.get(k, "?").strip() for k in
      ("MemTotal", "SwapTotal", "CommitLimit", "Committed_AS")))
for gib in (12, 8, 4):
    size = gib << 30
    out = []
    try:
        fd = os.memfd_create("arise-test")
        os.ftruncate(fd, size)
        m = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
        m.close(); out.append("memfd shared ok")
    except OSError as e:
        out.append("memfd shared FAILED (%s)" % e.strerror)
    finally:
        try:
            os.close(fd)
        except Exception:
            pass
    try:
        m = mmap.mmap(-1, size, mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS, mmap.PROT_READ | mmap.PROT_WRITE)
        m.close(); out.append("anonymous ok")
    except OSError as e:
        out.append("anonymous FAILED (%s)" % e.strerror)
    try:
        noreserve = getattr(mmap, "MAP_NORESERVE", 0x4000)
        m = mmap.mmap(-1, size, mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS | noreserve, mmap.PROT_READ | mmap.PROT_WRITE)
        m.close(); out.append("anonymous noreserve ok")
    except OSError as e:
        out.append("anonymous noreserve FAILED (%s)" % e.strerror)
    print("%d GiB: %s" % (gib, ", ".join(out)))
PY
fi
echo "== appimage $ARGV0 ($APPDIR) ${flags[*]} FEX $fex Qt $qt${QT_QPA_PLATFORM:+ ($QT_QPA_PLATFORM)}"
# AriseOS: while a Switch emulator runs, log the phone's free memory and the biggest processes every 15 s, so a
# session Android ends for memory (LOW_MEMORY) shows what grew before it.
sampler=
if [ -e "$APPDIR/usr/bin/eden-cli" ] && command -v python3 >/dev/null 2>&1; then
  python3 -u - <<'PY' 2>/dev/null | sed -u 's/^/== mem: /' &
import os, time
def kb(text, key):
    for line in text.splitlines():
        if line.startswith(key + ":"):
            return int(line.split()[1])
    return 0
start = time.time()
ticks = os.sysconf("SC_CLK_TCK")
last = {}
while True:
    try:
        mi = open("/proc/meminfo").read()
        procs = []
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                st = open("/proc/%s/status" % pid).read()
            except OSError:
                continue
            rss = kb(st, "VmRSS")
            if rss > 50 * 1024:
                name = st.split("\n", 1)[0].split(":", 1)[1].strip()
                try:
                    f = open("/proc/%s/stat" % pid).read().rsplit(")", 1)[1].split()
                    cpu = (int(f[11]) + int(f[12])) / ticks
                except (OSError, IndexError, ValueError):
                    cpu = 0
                busy = int(100 * (cpu - last.get(pid, cpu)) / 15)
                last[pid] = cpu
                procs.append((rss, name, kb(st, "RssAnon"), kb(st, "RssShmem"), kb(st, "VmSwap"), busy, kb(st, "Threads"), pid))
        procs.sort(reverse=True)
        # Busy threads of the biggest process (the emulator): which one spins when a game hangs.
        if procs:
            big = procs[0][7]
            hot = []
            try:
                for tid in os.listdir("/proc/%s/task" % big):
                    try:
                        f = open("/proc/%s/task/%s/stat" % (big, tid)).read()
                        comm = f[f.index("(") + 1:f.rindex(")")]
                        rest = f.rsplit(")", 1)[1].split()
                        cpu = (int(rest[11]) + int(rest[12])) / ticks
                        majflt = int(rest[9])
                    except (OSError, ValueError, IndexError):
                        continue
                    key = "t" + tid
                    busy = int(100 * (cpu - last.get(key, cpu)) / 15)
                    last[key] = cpu
                    faults = majflt - last.get("f" + tid, majflt)
                    last["f" + tid] = majflt
                    if busy >= 10 or faults >= 150:
                        hot.append((busy, comm, rest[0] + (", %d disk faults" % faults if faults else "")))
            except OSError:
                pass
            if hot:
                hot.sort(reverse=True)
                print("      busy threads: " + ", ".join("%s %d%% (%s)" % (c, b, st) for b, c, st in hot[:8]))
        top = ", ".join("%s %d MiB (anon %d, shm %d, swap %d, cpu %d%%, %d threads)" % (n, r >> 10, a >> 10, sh >> 10,
                        sw >> 10, b, t) for r, n, a, sh, sw, b, t, _ in procs[:5])
        # Major faults (pages read back from storage or swap) every 15 s: guest memory lives in a
        # file, and a working set Android evicted shows up here as stalls of the emulated cores.
        try:
            vm = dict(line.split() for line in open("/proc/vmstat").read().splitlines() if len(line.split()) == 2)
            majors = int(vm.get("pgmajfault", 0))
            swapins = int(vm.get("pswpin", 0))
            print("      disk reads: %d major faults, %d pages from swap in 15 s" % (
                majors - last.get("vm_maj", majors), swapins - last.get("vm_swin", swapins)))
            last["vm_maj"] = majors
            last["vm_swin"] = swapins
        except (OSError, ValueError):
            pass
        try:
            gpu = "%d MiB" % (int(open("/sys/class/kgsl/kgsl/page_alloc").read().split()[0]) >> 20)
        except (OSError, ValueError, IndexError):
            gpu = "?"
        for busy_path in ("/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage", "/sys/class/kgsl/kgsl-3d0/devfreq/gpu_load"):
            try:
                gpu += ", busy %s%%" % open(busy_path).read().split()[0].rstrip("%")
                break
            except (OSError, IndexError):
                pass
        try:
            gpu += ", %d MHz" % (int(open("/sys/class/kgsl/kgsl-3d0/gpuclk").read().split()[0]) // 1000000)
        except (OSError, ValueError, IndexError):
            pass
        print("%4ds available %d MiB, swap free %d of %d MiB, shmem %d MiB, GPU (kgsl) %s | %s" % (
            time.time() - start, kb(mi, "MemAvailable") >> 10, kb(mi, "SwapFree") >> 10, kb(mi, "SwapTotal") >> 10,
            kb(mi, "Shmem") >> 10, gpu, top))
    except Exception as e:
        print("sampler: %s" % e)
    time.sleep(15)
PY
  sampler=$!
fi
cd "$APPDIR" || exit 1
started=$(mktemp "${TMPDIR:-/tmp}/droiddeck-appimage.XXXXXX")
case ${DBUS_SESSION_BUS_ADDRESS:-} in
  unix:*) "${run[@]}" "${flags[@]}" "$@" ;;
  *) unset DBUS_SESSION_BUS_ADDRESS
     if command -v dbus-run-session >/dev/null 2>&1; then
       dbus-run-session -- "${run[@]}" "${flags[@]}" "$@"
     else
       "${run[@]}" "${flags[@]}" "$@"
     fi ;;
esac
rc=$?
[ -n "$sampler" ] && kill "$sampler" 2>/dev/null
if [ "$rc" -gt 128 ]; then
  echo "== appimage $ARGV0: ended by signal $((rc - 128)) ($(kill -l $((rc - 128)) 2>/dev/null))"
else
  echo "== appimage $ARGV0: exited with status $rc"
fi
if [ "$rc" -ne 0 ] && [ -n "$started" ]; then
  find "${HOME:-/root}/.local/share" "${HOME:-/root}/.config" "${HOME:-/root}/.cache" -maxdepth 4 -type f \
    \( -iname '*.log' -o -iname '*log*.txt' \) -newer "$started" -size -64M 2>/dev/null | head -n 3 |
    while IFS= read -r log; do
      echo "== appimage $ARGV0: end of $log"
      tail -n 40 "$log" | LC_ALL=C tr -cd '\11\12\40-\176' | cut -c1-400
    done
fi
rm -f "$started"
image_running() {
  local p exe arg cwd
  for p in /proc/[0-9]*; do
    exe=$(readlink "$p/exe" 2>/dev/null) || continue
    case $exe in "$APPDIR"/*) return 0 ;; esac
    case $exe in
      */FEX|*/FEXInterpreter)
        arg=$(tr '\0' '\n' < "$p/cmdline" 2>/dev/null | sed -n 2p)
        cwd=$(readlink "$p/cwd" 2>/dev/null)
        case $arg in "$APPDIR"/*) return 0 ;; esac
        case $cwd in "$APPDIR"|"$APPDIR"/*) return 0 ;; esac
        ;;
    esac
  done
  return 1
}
while image_running; do sleep 2; done
exit $rc
