From: Alway-L <felipemoura2015078@gmail.com>
Subject: [PATCH] arm64: load the loader, program and ld.so below 64 GiB

At 128/192/252 GiB they split the 64-512 GiB range of a 39-bit address
space, where Eden-family emulators reserve a 256 GiB block.
---
diff --git a/src/arch.h b/src/arch.h
index 06b7f1b..2e3117e 100644
--- a/src/arch.h
+++ b/src/arch.h
@@ -135,9 +135,12 @@ typedef unsigned char byte_t;
     #define OFFSETOF_STAT_UID_32 24
     #define OFFSETOF_STAT_GID_32 28
 
-    #define LOADER_ADDRESS     0x2000000000
-    #define EXEC_PIC_ADDRESS   0x3000000000
-    #define INTERP_PIC_ADDRESS 0x3f00000000
+    /* AriseOS: below 64 GiB. At 128/192/252 GiB the loader, program and ld.so split the 64-512 GiB range of a
+     * 39-bit address space, and emulators that reserve a 256 GiB block in it (Eden family: Orchid, Eglantine,
+     * Lichii) found no room, so their games hung. */
+    #define LOADER_ADDRESS     0x0800000000
+    #define EXEC_PIC_ADDRESS   0x0a00000000
+    #define INTERP_PIC_ADDRESS 0x0f00000000
     #define HAS_POKEDATA_WORKAROUND true
 
     #define HAS_LOADER_32BIT true
