From 830d88b1fa68bdccebe2770709d831a292590c44 Mon Sep 17 00:00:00 2001
From: Alway-L <felipemoura2015078@gmail.com>
Date: Fri, 6 Nov 2026 23:46:02 -0300
Subject: [PATCH 04/29] settings: AriseOS phone defaults on ARM64 (12 GiB,
 0.5x, Mailbox, low accuracy, async shaders, no reactive flushing, no Vulkan
 check)

(cherry picked from commit 370a48111c26e2311dce4f9ac285f3065c4fca71)
(cherry picked from commit a42300dbb290ca9c876d597f5e6e1c6bcc892893)
---
 src/common/settings.h | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/common/settings.h b/src/common/settings.h
index bdc0e2f20a..a6685d29b6 100644
--- a/src/common/settings.h
+++ b/src/common/settings.h
@@ -213,7 +213,11 @@ struct Values {
     SwitchableSetting<bool> use_multi_core{linkage, true, "use_multi_core", Category::Core};
     // 8 GB: Ocarina of Time's own memory size (the Frizti builds are tuned for it).
     SwitchableSetting<MemoryLayout, true> memory_layout_mode{linkage,
+#ifdef ARCHITECTURE_arm64
+                                                             MemoryLayout::Memory_12Gb,
+#else
                                                              MemoryLayout::Memory_8Gb,
+#endif
                                                              "memory_layout_mode",
                                                              Category::Core,
                                                              Specialization::Default,
@@ -355,7 +359,12 @@ struct Values {
 
     // Graphics Settings
     ResolutionScalingInfo resolution_info{};
-    SwitchableSetting<ResolutionSetup> resolution_setup{linkage, ResolutionSetup::Res1X,
+    SwitchableSetting<ResolutionSetup> resolution_setup{linkage,
+#ifdef ARCHITECTURE_arm64
+                                                        ResolutionSetup::Res1_2X,
+#else
+                                                        ResolutionSetup::Res1X,
+#endif
                                                         "resolution_setup", Category::Renderer};
 
     // Mailbox: the host frame pacer (vk_host_pacer.h) times presents to the display itself.
@@ -722,7 +731,7 @@ struct Values {
                                             Category::RendererAdvanced};
 
     SwitchableSetting<bool> use_reactive_flushing{linkage,
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARCHITECTURE_arm64)
                                                   false,
 #else
                                                   true,
@@ -887,7 +896,11 @@ struct Values {
 
     // Docked: the docked rendering resolution (as Ocarina of Time on a TV).
     SwitchableSetting<ConsoleMode> use_docked_mode{linkage,
+#ifdef ARCHITECTURE_arm64
+                                                   ConsoleMode::Handheld,
+#else
                                                    ConsoleMode::Docked,
+#endif
                                                    "use_docked_mode",
                                                    Category::System,
                                                    Specialization::Radio,
@@ -1021,7 +1034,11 @@ struct Values {
                                 linkage, false, "use_auto_stub", Category::Debugging};
     Setting<bool> enable_all_controllers{linkage, false, "enable_all_controllers",
                                          Category::Debugging};
+#ifdef ARCHITECTURE_arm64
+    Setting<bool> perform_vulkan_check{linkage, false, "perform_vulkan_check", Category::Debugging};
+#else
     Setting<bool> perform_vulkan_check{linkage, true, "perform_vulkan_check", Category::Debugging};
+#endif
     Setting<bool> disable_web_applet{linkage, true, "disable_web_applet", Category::Debugging};
 
     // GPU Logging
-- 
