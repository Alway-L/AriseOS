From f1335bf23c312a139dfb8abd46a9f8a8a752ed4c Mon Sep 17 00:00:00 2001
From: pavelgajdo <pavel.gajdo@gmail.com>
Date: Thu, 5 Nov 2026 22:48:24 +0100
Subject: [PATCH 13/29] nx2 video: wake the client when a decoded frame is
 ready

The client waits on one event for both input room and finished frames.
It was signalled only while the input queue was below its watermark, so
a movie whose small AV1 frames keep hundreds of inputs queued woke the
client only on its ~100 ms timeout. Signal it when an output is queued
and keep it pending until the outputs are fetched.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3943fe4e8b80008d2d57f7c99ae2a2e65cefd99c)
(cherry picked from commit 8c61e11e07764223d78b01ba2f1a7b028916eea7)
(cherry picked from commit 1392d4efb51f3701411e566dd262633980449334)
---
 src/core/hle/service/nx2_gsv.h         |  2 ++
 src/core/hle/service/nx2_video_ready.h | 15 ++++++++++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/core/hle/service/nx2_gsv.h b/src/core/hle/service/nx2_gsv.h
index 9584ca3806..67b1084953 100644
--- a/src/core/hle/service/nx2_gsv.h
+++ b/src/core/hle/service/nx2_gsv.h
@@ -3328,6 +3328,7 @@ private:
             } else if (Nx2VideoSyncTraceEnabled()) {
                 ++m_sync.empty_polls;
             }
+            m_ready->output_ready.store(!m_outputs.empty(), std::memory_order_relaxed);
         }
         if (!output) {
             if (Nx2VideoTraceEnabled()) {
@@ -3448,6 +3449,7 @@ private:
                     m_ready->room.store(false, std::memory_order_relaxed);
                 }
                 system.Host1x().GetSyncpointManager().IncrementGuest(m_syncpoint);
+                m_ready->SignalOutput(system.Kernel());
                 m_last_output = m_outputs.back();
                 if (Nx2VideoPtsSyncEnabled()) {
                     NoteWritten(frame);
diff --git a/src/core/hle/service/nx2_video_ready.h b/src/core/hle/service/nx2_video_ready.h
index 492becc83e..ab20ef99a5 100644
--- a/src/core/hle/service/nx2_video_ready.h
+++ b/src/core/hle/service/nx2_video_ready.h
@@ -13,11 +13,19 @@ namespace Service {
 struct Nx2VideoReadyState {
     void Signal(Kernel::KernelCore& kernel) {
         std::scoped_lock lk{mutex};
-        if (event != nullptr && running && room.load(std::memory_order_relaxed)) {
+        if (event != nullptr && running &&
+            (room.load(std::memory_order_relaxed) ||
+             output_ready.load(std::memory_order_relaxed))) {
             event->Signal(kernel);
         }
     }
 
+    /// A decoded frame is waiting for the client: wake it now, whatever the input queue level.
+    void SignalOutput(Kernel::KernelCore& kernel) {
+        output_ready.store(true, std::memory_order_relaxed);
+        Signal(kernel);
+    }
+
     void SetRunning(Kernel::KernelCore& kernel, bool value) {
         std::scoped_lock lk{mutex};
         running = value;
@@ -29,6 +37,11 @@ struct Nx2VideoReadyState {
     std::mutex mutex;
     Kernel::KEvent* event{};
     std::atomic<bool> room{true};
+    /// Outputs are waiting to be fetched. The client waits on this one event for both input room
+    /// and finished frames: with only `room` (input queue below its watermark) a movie whose tiny
+    /// AV1 frames keep hundreds of inputs queued woke the client only on its ~100 ms timeout,
+    /// playing at ~8 fps.
+    std::atomic<bool> output_ready{false};
 
 private:
     bool running{true};
