@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <array>
+#include <catch2/catch_test_macros.hpp>
+
+#include "video_core/renderer_vulkan/pipeline_optimization.h"
+
+TEST_CASE("Only known AMD proprietary shaders disable pipeline optimization",
+          "[video_core][vulkan][pipeline_optimization]") {
+    constexpr std::array<u64, 2> hashes{0xeff3ccbe1438679dULL, 0xf9ea14a22394f5b1ULL};
+    for (const u64 hash : hashes) {
+        CHECK(Vulkan::BuildsUnoptimized(VK_DRIVER_ID_AMD_PROPRIETARY, hash));
+        for (const auto driver : {VK_DRIVER_ID_AMD_OPEN_SOURCE, VK_DRIVER_ID_MESA_RADV,
+                                  VK_DRIVER_ID_NVIDIA_PROPRIETARY,
+                                  VK_DRIVER_ID_INTEL_PROPRIETARY_WINDOWS,
+                                  VK_DRIVER_ID_QUALCOMM_PROPRIETARY, VK_DRIVER_ID_MESA_TURNIP}) {
+            CHECK_FALSE(Vulkan::BuildsUnoptimized(driver, hash));
+        }
+        CHECK_FALSE(Vulkan::BuildsUnoptimized(VK_DRIVER_ID_AMD_PROPRIETARY, hash ^ 1));
+    }
+    CHECK_FALSE(Vulkan::BuildsUnoptimized(VK_DRIVER_ID_AMD_PROPRIETARY, 0));
+    CHECK_FALSE(Vulkan::BuildsUnoptimized(VK_DRIVER_ID_AMD_PROPRIETARY, 0x3c2193d0166610b3ULL));
+    for (const u64 hash : {0x8c29514395041853ULL, 0xc332d87961d23b13ULL,
+                           0xb2f024003969e2dcULL}) {
+        CHECK_FALSE(Vulkan::BuildsUnoptimized(VK_DRIVER_ID_AMD_PROPRIETARY, hash));
+    }
+}
diff --git a/src/tests/video_core/spirv_atomic_retry.cpp b/src/tests/video_core/spirv_atomic_retry.cpp
new file mode 100644
index 0000000000..3ac87e5e08
--- /dev/null
+++ b/src/tests/video_core/spirv_atomic_retry.cpp
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <span>
+#include <string>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#include <spirv/unified1/spirv.hpp11>
+
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/frontend/ir/ir_emitter.h"
+
+namespace {
+using namespace Shader;
+
+std::vector<std::vector<u32>> Instructions(const std::vector<u32>& code, spv::Op opcode) {
+    std::vector<std::vector<u32>> result;
+    for (size_t offset = 5; offset < code.size();) {
+        const u32 size = code[offset] >> 16;
+        REQUIRE(size != 0);
+        REQUIRE(offset + size <= code.size());
+        if ((code[offset] & 0xffffU) == static_cast<u32>(opcode)) {
+            const auto words = std::span{code}.subspan(offset + 1, size - 1);
+            result.emplace_back(words.begin(), words.end());
+        }
+        offset += size;
+    }
+    return result;
+}
+
+std::vector<u32> EmitAtomicHelpers(bool native_half, bool explicit_shared) {
+    ObjectPool<IR::Inst> pool;
+    IR::Block block{pool};
+    IR::Program program;
+    program.stage = Stage::Compute;
+    program.workgroup_size = {256, 1, 1};
+    program.shared_memory_size = 16;
+    program.blocks = {&block};
+    program.post_order_blocks = {&block};
+    program.syntax_list = {{{.block = &block}, IR::AbstractSyntaxNode::Type::Block},
+                           {{}, IR::AbstractSyntaxNode::Type::Return}};
+    auto& info = program.info;
+    info.storage_buffers_descriptors = {{0, 0, 1, true}};
+    info.used_storage_buffer_types = IR::Type::U32;
+    info.uses_shared_increment = true;
+    info.uses_shared_decrement = true;
+    info.uses_global_increment = true;
+    info.uses_global_decrement = true;
+    info.uses_atomic_f32_add = true;
+    info.uses_fp16 = native_half;
+    info.uses_atomic_f16x2_add = native_half;
+    info.uses_atomic_f16x2_min = native_half;
+    info.uses_atomic_f16x2_max = native_half;
+    info.uses_atomic_f32x2_add = !native_half;
+    info.uses_atomic_f32x2_min = !native_half;
+    info.uses_atomic_f32x2_max = !native_half;
+    info.uses_int8 = true;
+    info.uses_int16 = true;
+    Profile profile;
+    profile.supported_spirv = 0x00010500;
+    profile.support_explicit_workgroup_layout = explicit_shared;
+    profile.support_workgroup_layout_8bit_access = explicit_shared;
+    profile.support_workgroup_layout_16bit_access = explicit_shared;
+    auto code = Backend::SPIRV::EmitSPIRV(profile, program);
+    if (const char* directory = std::getenv("EDEN_ATOMIC_TEST_OUTPUT")) {
+        std::filesystem::create_directories(directory);
+        const auto name = std::string{native_half ? "native-half" : "packed-half"} +
+                          (explicit_shared ? "-explicit" : "-implicit") + ".spv";
+        std::ofstream file{std::filesystem::path{directory} / name, std::ios::binary};
+        file.write(reinterpret_cast<const char*>(code.data()),
+                   static_cast<std::streamsize>(code.size() * sizeof(u32)));
+        REQUIRE(file.good());
+    }
+    return code;
+}
+}
+
+TEST_CASE("SPIR-V CAS retries use the exchange result as the next expected word",
+          "[video_core][spirv][atomic_retry]") {
+    for (const bool native_half : {true, false}) {
+        for (const bool explicit_shared : {false, true}) {
+            CAPTURE(native_half, explicit_shared);
+            const auto code = EmitAtomicHelpers(native_half, explicit_shared);
+            const auto exchanges = Instructions(code, spv::Op::OpAtomicCompareExchange);
+            const auto loads = Instructions(code, spv::Op::OpLoad);
+            const auto stores = Instructions(code, spv::Op::OpStore);
+            const auto variables = Instructions(code, spv::Op::OpVariable);
+            const auto integers = Instructions(code, spv::Op::OpTypeInt);
+            const auto comparisons = Instructions(code, spv::Op::OpIEqual);
+            REQUIRE(exchanges.size() == (explicit_shared ? 9 : 11));
+            for (const auto& exchange : exchanges) {
+                REQUIRE(exchange.size() == 8);
+                const u32 type = exchange[0];
+                const u32 result = exchange[1];
+                const u32 memory = exchange[2];
+                const u32 expected = exchange[7];
+                CHECK(std::ranges::find(integers, std::vector<u32>{type, 32, 0}) != integers.end());
+                const auto expected_load = std::ranges::find_if(
+                    loads, [=](const auto& load) { return load[1] == expected; });
+                REQUIRE(expected_load != loads.end());
+                CHECK((*expected_load)[0] == type);
+                const u32 retry = (*expected_load)[2];
+                CHECK(retry != memory);
+                const auto variable = std::ranges::find_if(
+                    variables, [=](const auto& var) { return var[1] == retry; });
+                REQUIRE(variable != variables.end());
+                CHECK((*variable)[2] == static_cast<u32>(spv::StorageClass::Function));
+                REQUIRE(std::ranges::count_if(stores, [=](const auto& store) {
+                    return store[0] == retry;
+                }) == 2);
+                CHECK(std::ranges::find(stores, std::vector<u32>{retry, result}) != stores.end());
+                const auto initial = std::ranges::find_if(
+                    loads, [=](const auto& load) { return load[2] == memory; });
+                REQUIRE(initial != loads.end());
+                CHECK((*initial)[0] == type);
+                CHECK(std::ranges::count_if(loads, [=](const auto& load) {
+                    return load[2] == memory;
+                }) == 1);
+                CHECK(std::ranges::find(stores, std::vector<u32>{retry, (*initial)[1]}) != stores.end());
+                CHECK(std::ranges::any_of(comparisons, [=](const auto& comparison) {
+                    return (comparison[2] == result && comparison[3] == expected) ||
+                           (comparison[3] == result && comparison[2] == expected);
+                }));
+            }
+        }
+    }
+}
diff --git a/src/tests/video_core/spirv_fragment_shuffle.cpp b/src/tests/video_core/spirv_fragment_shuffle.cpp
new file mode 100644
index 0000000000..007d01fe17
--- /dev/null
+++ b/src/tests/video_core/spirv_fragment_shuffle.cpp
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <array>
+#include <bit>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <span>
+#include <string>
+#include <vector>
+#include <catch2/catch_test_macros.hpp>
+#define SPV_ENABLE_UTILITY_CODE
+#include <spirv/unified1/spirv.hpp11>
+
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/frontend/ir/ir_emitter.h"
+
+namespace {
+using namespace Shader;
+
+struct ShuffleModule {
+    std::vector<u32> code;
+    std::array<u32, 3> results;
+};
+
+ShuffleModule EmitShuffles(Stage stage, u32 subgroup_size, bool fragment_fallback,
+                           bool general_fallback = false) {
+    ObjectPool<IR::Inst> pool;
+    IR::Block block{pool};
+    IR::Program program;
+    program.stage = stage;
+    program.workgroup_size = {64, 1, 1};
+    program.blocks = {&block};
+    program.post_order_blocks = {&block};
+    program.syntax_list = {{{.block = &block}, IR::AbstractSyntaxNode::Type::Block},
+                           {{}, IR::AbstractSyntaxNode::Type::Return}};
+    program.info.uses_subgroup_invocation_id = true;
+    program.info.uses_subgroup_shuffles = true;
+    IR::IREmitter ir{block};
+    const auto lane = ir.LaneId();
+    const auto value = ir.IAdd(lane, ir.Imm32(100));
+    const std::array<IR::U32, 3> results{
+        ir.ShuffleIndex(value, ir.BitwiseXor(lane, ir.Imm32(1)), ir.Imm32(31), ir.Imm32(0)),
+        ir.ShuffleUp(value, ir.Imm32(1), ir.Imm32(0), ir.Imm32(0)),
+        ir.ShuffleDown(value, ir.Imm32(1), ir.Imm32(31), ir.Imm32(0)),
+    };
+    Profile profile;
+    profile.supported_spirv = 0x00010500;
+    profile.support_vote = true;
+    profile.support_shuffle_relative = true;
+    profile.max_subgroup_size = subgroup_size;
+    profile.warp_size_potentially_larger_than_guest = subgroup_size > 32;
+    profile.has_broken_spirv_fragment_shuffle = fragment_fallback;
+    profile.has_broken_spirv_subgroup_shuffle = general_fallback;
+    auto code = Backend::SPIRV::EmitSPIRV(profile, program);
+    if (const char* directory = std::getenv("EDEN_SHUFFLE_TEST_OUTPUT")) {
+        std::filesystem::create_directories(directory);
+        const auto name = std::to_string(static_cast<u32>(stage)) + "-" +
+                          std::to_string(subgroup_size) + "-" +
+                          std::to_string(fragment_fallback) + "-" +
+                          std::to_string(general_fallback) + ".spv";
+        std::ofstream file{std::filesystem::path{directory} / name, std::ios::binary};
+        file.write(reinterpret_cast<const char*>(code.data()),
+                   static_cast<std::streamsize>(code.size() * sizeof(u32)));
+        REQUIRE(file.good());
+    }
+    return {std::move(code), {results[0].Inst()->Definition<u32>(),
+                              results[1].Inst()->Definition<u32>(),
+                              results[2].Inst()->Definition<u32>()}};
+}
+}
+
+TEST_CASE("Fragment shuffle fallback preserves host subgroup partitions",
+          "[video_core][spirv][fragment_shuffle]") {
+    for (const u32 subgroup_size : {32U, 64U}) {
+        const auto module = EmitShuffles(Stage::Fragment, subgroup_size, true);
+        std::map<u32, std::vector<u32>> definitions;
+        std::vector<u32> broadcast_lanes;
+        u32 invocation_variable{};
+        for (size_t offset = 5; offset < module.code.size();) {
+            const u32 size = module.code[offset] >> 16;
+            REQUIRE(size != 0);
+            REQUIRE(offset + size <= module.code.size());
+            const auto words = std::span{module.code}.subspan(offset, size);
+            const auto op = static_cast<spv::Op>(words[0] & 0xffffU);
+            CHECK(op != spv::Op::OpGroupNonUniformShuffle);
+            CHECK(op != spv::Op::OpGroupNonUniformShuffleUp);
+            CHECK(op != spv::Op::OpGroupNonUniformShuffleDown);
+            bool has_result{}, has_type{};
+            spv::HasResultAndType(op, &has_result, &has_type);
+            if (has_result && has_type) {
+                definitions.emplace(words[2], std::vector<u32>{words.begin(), words.end()});
+            }
+            if (op == spv::Op::OpGroupNonUniformBroadcast) {
+                broadcast_lanes.push_back(words[5]);
+            }
+            if (op == spv::Op::OpDecorate &&
+                words[2] == static_cast<u32>(spv::Decoration::BuiltIn) &&
+                words[3] == static_cast<u32>(spv::BuiltIn::SubgroupLocalInvocationId)) {
+                invocation_variable = words[1];
+            }
+            offset += size;
+        }
+        REQUIRE(broadcast_lanes.size() == 3 * subgroup_size);
+        REQUIRE(invocation_variable != 0);
+        for (u32 index = 0; index < broadcast_lanes.size(); ++index) {
+            CHECK(definitions.at(broadcast_lanes[index])[3] == index % subgroup_size);
+        }
+        const auto evaluate = [&](auto&& self, u32 id, u32 lane) -> u32 {
+            const auto& words = definitions.at(id);
+            const auto arg = [&](size_t index) { return self(self, words[index], lane); };
+            switch (static_cast<spv::Op>(words[0] & 0xffffU)) {
+            case spv::Op::OpConstant: return words[3];
+            case spv::Op::OpLoad:
+                REQUIRE(words[3] == invocation_variable);
+                return lane;
+            case spv::Op::OpIAdd: return arg(3) + arg(4);
+            case spv::Op::OpISub: return arg(3) - arg(4);
+            case spv::Op::OpBitwiseAnd: return arg(3) & arg(4);
+            case spv::Op::OpBitwiseOr: return arg(3) | arg(4);
+            case spv::Op::OpBitwiseXor: return arg(3) ^ arg(4);
+            case spv::Op::OpNot: return ~arg(3);
+            case spv::Op::OpShiftLeftLogical: return arg(3) << arg(4);
+            case spv::Op::OpShiftRightLogical: return arg(3) >> arg(4);
+            case spv::Op::OpIEqual: return arg(3) == arg(4);
+            case spv::Op::OpSLessThanEqual:
+                return std::bit_cast<s32>(arg(3)) <= std::bit_cast<s32>(arg(4));
+            case spv::Op::OpSGreaterThanEqual:
+                return std::bit_cast<s32>(arg(3)) >= std::bit_cast<s32>(arg(4));
+            case spv::Op::OpSelect: return arg(3) ? arg(4) : arg(5);
+            case spv::Op::OpGroupNonUniformBroadcast:
+                CHECK(arg(5) / 32 == lane / 32);
+                return self(self, words[4], arg(5));
+            default: FAIL("Unexpected shuffle opcode " << (words[0] & 0xffffU));
+            }
+            return 0;
+        };
+        for (u32 lane = 0; lane < subgroup_size; ++lane) {
+            CAPTURE(subgroup_size, lane);
+            const u32 guest_lane = lane % 32;
+            CHECK(evaluate(evaluate, module.results[0], lane) == 100 + (guest_lane ^ 1));
+            CHECK(evaluate(evaluate, module.results[1], lane) ==
+                  100 + (guest_lane == 0 ? 0 : guest_lane - 1));
+            CHECK(evaluate(evaluate, module.results[2], lane) ==
+                  100 + (guest_lane == 31 ? 31 : guest_lane + 1));
+        }
+    }
+}
+
+TEST_CASE("Fragment workaround leaves other stages on native shuffles",
+          "[video_core][spirv][fragment_shuffle]") {
+    for (const auto stage : {Stage::Fragment, Stage::Compute, Stage::VertexB}) {
+        for (const bool fragment_fallback : {false, true}) {
+            for (const bool general_fallback : {false, true}) {
+                const auto module = EmitShuffles(stage, 64, fragment_fallback, general_fallback);
+                size_t broadcasts{}, shuffles{};
+                for (size_t offset = 5; offset < module.code.size();) {
+                    const u32 size = module.code[offset] >> 16;
+                    REQUIRE(size != 0);
+                    const auto op = static_cast<spv::Op>(module.code[offset] & 0xffffU);
+                    broadcasts += op == spv::Op::OpGroupNonUniformBroadcast;
+                    shuffles += op == spv::Op::OpGroupNonUniformShuffle ||
+                                op == spv::Op::OpGroupNonUniformShuffleUp ||
+                                op == spv::Op::OpGroupNonUniformShuffleDown;
+                    offset += size;
+                }
+                const bool fallback = general_fallback ||
+                                      (fragment_fallback && stage == Stage::Fragment);
+                CHECK(broadcasts == (fallback ? 192 : 0));
+                CHECK(shuffles == (fallback ? 0 : 3));
+            }
+        }
+    }
+}
