From 2ecff0d2d8feadc610d4ca24616d36f1dc689ef7 Mon Sep 17 00:00:00 2001
From: pavelgajdo <pavel.gajdo@gmail.com>
Date: Fri, 6 Nov 2026 15:29:01 +0100
Subject: [PATCH 14/26] vk_query_cache: poll occlusion results instead of
 waiting on them forever

Ocarina of Time froze right after its intro on Xclipse (RADV): the fencing
thread waited in vkGetQueryPoolResults(WAIT_BIT) on occlusion slots that
never became available, while the GPU thread waited for that fence. Their
begin and end had been recorded into a submission the GPU had finished, and
no reset came after; why the results never land is still open (a host or
GPU-side reset and #639 did not change it).

Sync now polls with WITH_AVAILABILITY_BIT and, after 2 s, reads what never
became available as 0 and logs it. The game then goes on into gameplay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit e74ace423af5bd84136814bdea498482a1f965cd)
(cherry picked from commit 2bc2656d0cfd3a08969d15a8acba9ddf6ab50cba)
---
 .../renderer_vulkan/vk_query_cache.cpp        | 62 +++++++++++++++----
 1 file changed, 51 insertions(+), 11 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_query_cache.cpp b/src/video_core/renderer_vulkan/vk_query_cache.cpp
index 5a6a6026cd..8cb52510fd 100644
--- a/src/video_core/renderer_vulkan/vk_query_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_query_cache.cpp
@@ -4,11 +4,15 @@
 // SPDX-FileCopyrightText: Copyright 2023 yuzu Emulator Project
 // SPDX-License-Identifier: GPL-3.0-or-later
 
+#include <algorithm>
+#include <array>
+#include <chrono>
 #include <cstddef>
 #include <limits>
 #include <map>
 #include <memory>
 #include <span>
+#include <thread>
 #include <type_traits>
 #include "common/container/unordered_map.h"
 #include <utility>
@@ -83,19 +87,55 @@ public:
         return BankBase::IsDead() && scheduler.IsFree(last_used_tick);
     }
 
+    // Polled rather than read with VK_QUERY_RESULT_WAIT_BIT: a slot that never becomes available
+    // made the wait spin forever inside RADV with all GPU work finished (Ocarina of Time froze
+    // right after its intro on Xclipse; their begin and end were recorded into a submission the GPU
+    // had finished, and no reset came after). Such slots read as 0 after a while and are logged.
     void Sync(size_t start, size_t size) {
         const auto& dev = device.GetLogical();
-        const VkResult query_result = dev.GetQueryResults(
-            *query_pool, static_cast<u32>(start), static_cast<u32>(size), sizeof(u64) * size,
-            &host_results[start], sizeof(u64), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
-        switch (query_result) {
-        case VK_SUCCESS:
-            return;
-        case VK_ERROR_DEVICE_LOST:
-            device.ReportLoss();
-            [[fallthrough]];
-        default:
-            throw vk::Exception(query_result);
+        std::vector<std::array<u64, 2>> results(size);
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{2};
+        for (u32 spins = 0;; ++spins) {
+            const VkResult query_result = dev.GetQueryResults(
+                *query_pool, static_cast<u32>(start), static_cast<u32>(size),
+                results.size() * sizeof(results[0]), results.data(), sizeof(results[0]),
+                VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+            if (query_result == VK_ERROR_DEVICE_LOST) {
+                device.ReportLoss();
+                throw vk::Exception(query_result);
+            }
+            if (query_result != VK_SUCCESS && query_result != VK_NOT_READY) {
+                throw vk::Exception(query_result);
+            }
+            if (query_result == VK_SUCCESS || std::chrono::steady_clock::now() >= deadline) {
+                break;
+            }
+            if (spins < 64) {
+                std::this_thread::yield();
+            } else {
+                std::this_thread::sleep_for(std::chrono::microseconds{50});
+            }
+        }
+        size_t unavailable = 0;
+        size_t first_unavailable = size;
+        for (size_t i = 0; i < size; ++i) {
+            if (results[i][1] != 0) {
+                host_results[start + i] = results[i][0];
+            } else {
+                host_results[start + i] = 0;
+                first_unavailable = (std::min)(first_unavailable, i);
+                ++unavailable;
+            }
+        }
+        if (unavailable != 0) {
+            static u32 logged{};
+            if (logged++ < 32) {
+                LOG_WARNING(Render_Vulkan,
+                            "Occlusion query bank {}: {} of slots {}..{} never became available "
+                            "(first {}); read as 0. GPU tick {}, last used tick {}",
+                            index, unavailable, start, start + size - 1, start + first_unavailable,
+                            scheduler.GetMasterSemaphore().KnownGpuTick(), last_used_tick);
+            }
         }
     }
 
