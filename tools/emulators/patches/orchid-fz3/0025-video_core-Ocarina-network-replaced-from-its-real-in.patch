 src/video_core/rasterizer_interface.h         |  7 ++
 .../renderer_vulkan/vk_rasterizer.cpp         |  7 ++
 .../renderer_vulkan/vk_rasterizer.h           |  3 +
 src/video_core/texture_cache/texture_cache.h  | 75 +++++++++++++++++++
 .../texture_cache/texture_cache_base.h        |  5 ++
 6 files changed, 116 insertions(+), 23 deletions(-)

diff --git a/src/video_core/engines/kepler_compute.cpp b/src/video_core/engines/kepler_compute.cpp
