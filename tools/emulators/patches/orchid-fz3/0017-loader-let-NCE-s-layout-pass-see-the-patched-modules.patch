From 84998c90ede890ba80d5e95ff5278bdb015c170c Mon Sep 17 00:00:00 2001
From: pavelgajdo <pavel.gajdo@gmail.com>
Date: Sat, 7 Nov 2026 00:14:02 +0100
Subject: [PATCH 17/26] loader: let NCE's layout pass see the patched modules

The first module pass computes NCE's trampolines (SVC, MRS and PAC
rewrites) from code loaded without the patch manager, so instructions a
patch adds ran unrewritten. Dark's Dynamic FPS for Ocarina of Time,
bundled since #240, reads CNTPCT_EL0 at main+0x3C4620C: Android traps it
and the game died of SIGILL while compiling its boot shaders.

Both passes now use one PatchManager.

Tested on a Galaxy S26: Ocarina of Time boots to the title screen with
Dynamic FPS applied (~125 FPS without the speed limit).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 0279cc4a62ef01993f204f3801914474f4fe1052)
(cherry picked from commit 709ec15b40154382070400830ae65ba70ad22cdc)
---
 src/core/loader/deconstructed_rom_directory.cpp | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/core/loader/deconstructed_rom_directory.cpp b/src/core/loader/deconstructed_rom_directory.cpp
index 491535a62d..37d3a5ebd1 100644
--- a/src/core/loader/deconstructed_rom_directory.cpp
+++ b/src/core/loader/deconstructed_rom_directory.cpp
@@ -458,6 +458,12 @@ AppLoader_DeconstructedRomDirectory::LoadResult AppLoader_DeconstructedRomDirect
     // Define an nce patch context for each potential module.
     PatchCollection patch_ctx{is_application};
 
+    // The layout pass must see the code as patched: NCE rewrites the SVCs and MRS reads it finds
+    // here, so a patch adding one (Dark's Dynamic FPS for Ocarina of Time reads CNTPCT_EL0)
+    // would otherwise run it raw and die of SIGILL.
+    const FileSys::PatchManager pm{metadata.GetTitleID(), system.GetFileSystemController(),
+                                   system.GetContentProvider()};
+
     // Use the NSO module loader to figure out the code layout
     for (size_t i = 0; i < static_modules.size(); i++) {
         const auto& module = static_modules[i];
@@ -468,7 +474,7 @@ AppLoader_DeconstructedRomDirectory::LoadResult AppLoader_DeconstructedRomDirect
 
         const bool should_pass_arguments = std::strcmp(module, "rtld") == 0;
         const auto tentative_next_load_addr = AppLoader_NSO::LoadModule(
-            process, system, *module_file, code_size, should_pass_arguments, false, {},
+            process, system, *module_file, code_size, should_pass_arguments, false, pm,
             patch_ctx.GetPatchers(), patch_ctx.GetLastIndex());
         if (!tentative_next_load_addr) {
             return {ResultStatus::ErrorLoadingNSO, {}};
@@ -504,8 +510,6 @@ AppLoader_DeconstructedRomDirectory::LoadResult AppLoader_DeconstructedRomDirect
     modules.clear();
     const VAddr base_address{GetInteger(process.GetEntryPoint())};
     VAddr next_load_addr{base_address};
-    const FileSys::PatchManager pm{metadata.GetTitleID(), system.GetFileSystemController(),
-                                   system.GetContentProvider()};
     for (size_t i = 0; i < static_modules.size(); i++) {
         const auto& module = static_modules[i];
         const FileSys::VirtualFile module_file{dir->GetFile(module)};
