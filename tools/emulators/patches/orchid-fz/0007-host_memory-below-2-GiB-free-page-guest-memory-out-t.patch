From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alway-L <felipemoura2015078@gmail.com>
Date: Sat, 7 Nov 2026 07:29:03 -0300
Subject: [PATCH 7/9] host_memory: below 2 GiB free, page guest memory out to
 swap in 512 MiB windows (MADV_PAGEOUT) instead of only marking it cold

---
 src/common/host_memory.cpp | 36 +++++++++++++++++++++++++-----------
 1 file changed, 25 insertions(+), 11 deletions(-)

diff --git a/src/common/host_memory.cpp b/src/common/host_memory.cpp
index e3d946b928..16aa57368b 100644
--- a/src/common/host_memory.cpp
+++ b/src/common/host_memory.cpp
@@ -553,29 +553,43 @@ static void AriseWatchMemory(u8* base, size_t size) {
     static std::once_flag started;
     std::call_once(started, [] {
         std::thread([] {
-            const char* value = std::getenv("ARISE_COLD_BELOW_MIB");
-            const size_t threshold = value != nullptr ? std::strtoull(value, nullptr, 10) : 1536;
+            // MADV_COLD alone did not get guest pages swapped before Android ended the app (swap use
+            // barely moved while 4.5 GiB of guest memory stayed in RAM). Below the threshold, compress
+            // a 512 MiB window of guest memory into swap every half second, walking through all of it:
+            // pages the game is not using stay out, those it uses come back on their next touch.
+            const char* value = std::getenv("ARISE_PAGEOUT_BELOW_MIB");
+            const size_t threshold = value != nullptr ? std::strtoull(value, nullptr, 10) : 2048;
             if (threshold == 0) {
                 return;
             }
+#ifndef MADV_PAGEOUT
+#define MADV_PAGEOUT 21
+#endif
+            constexpr size_t Window = 512ULL << 20;
+            size_t cursor = 0;
+            size_t passes = 0;
             int notes = 0;
             while (true) {
-                std::this_thread::sleep_for(std::chrono::seconds{2});
+                std::this_thread::sleep_for(std::chrono::milliseconds{500});
                 u8* const base = g_arise_backing_base.load();
                 const size_t size = g_arise_backing_size.load();
                 const size_t available = AriseAvailableMiB();
-                if (base == nullptr || available >= threshold) {
+                if (base == nullptr || size == 0 || available >= threshold) {
                     continue;
                 }
-#ifndef MADV_COLD
-#define MADV_COLD 20
-#endif
-                const int result = madvise(base, size, MADV_COLD);
-                if (notes < 5) {
+                if (cursor >= size) {
+                    cursor = 0;
+                    ++passes;
+                }
+                const size_t length = (std::min)(Window, size - cursor);
+                const int result = madvise(base + cursor, length, MADV_PAGEOUT);
+                if (notes < 6) {
                     ++notes;
-                    LOG_WARNING(HW_Memory, "AriseOS: {} MiB free on the phone, guest memory marked cold ({})",
-                                available, result == 0 ? "ok" : std::strerror(errno));
+                    LOG_WARNING(HW_Memory, "AriseOS: {} MiB free on the phone, guest memory {}-{} MiB sent to swap ({}, pass {})",
+                                available, cursor >> 20, (cursor + length) >> 20,
+                                result == 0 ? "ok" : std::strerror(errno), passes);
                 }
+                cursor += length;
             }
         }).detach();
     });
