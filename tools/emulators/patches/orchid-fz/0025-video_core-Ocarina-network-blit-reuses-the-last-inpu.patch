From 67b707f6e545d33674f7471eb7c92ac397d27e76 Mon Sep 17 00:00:00 2001
From: Alway-L <felipemoura2015078@gmail.com>
Date: Sat, 7 Nov 2026 11:50:24 -0300
Subject: [PATCH] video_core: Ocarina network blit reuses the last input it
 found, crops to the rendered size, scans every constant buffer and logs both
 networks

---
 src/video_core/engines/kepler_compute.cpp | 190 +++++++++++++++-------
 1 file changed, 130 insertions(+), 60 deletions(-)

diff --git a/src/video_core/engines/kepler_compute.cpp b/src/video_core/engines/kepler_compute.cpp
index d3d8911fc8..032be7e73c 100644
--- a/src/video_core/engines/kepler_compute.cpp
+++ b/src/video_core/engines/kepler_compute.cpp
@@ -1226,6 +1226,8 @@ bool KeplerCompute::ProcessOcarinaMovie(u64 program_id, u64 native_key) {
 // B10G11R11 scene colour (native keys below). Emulated HMMA made it 490-815 ms of GPU time a
 // frame on an Adreno 830, ~90% of the frame. On ARM64 it is replaced by a bilinear blit of the
 // network's input colour into its output; EDEN_NX2_OOT_NETWORK=native keeps the network.
+// The input handle is not in the constant buffers on every dispatch, so the last one found for
+// each network is reused.
 bool KeplerCompute::ProcessOcarinaNetwork(u64 program_id, u64 native_key) {
     static constexpr std::array<u64, 2> NetworkKeys{0xd8efd9f0c95abd80ULL, 0x6f9367bd41dc0b58ULL};
 #ifdef ARCHITECTURE_arm64
@@ -1240,10 +1242,12 @@ bool KeplerCompute::ProcessOcarinaNetwork(u64 program_id, u64 native_key) {
     }();
 #endif
     static bool failed = false;
+    const auto key_it = std::ranges::find(NetworkKeys, native_key);
     if (!enabled || failed || program_id != VideoCommon::OcarinaMovie::ProgramId ||
-        std::ranges::find(NetworkKeys, native_key) == NetworkKeys.end()) {
+        key_it == NetworkKeys.end()) {
         return false;
     }
+    const size_t key_index = static_cast<size_t>(key_it - NetworkKeys.begin());
     using namespace Tegra::Texture;
     const auto target_format = [](const TICEntry& tic) -> std::optional<Tegra::RenderTargetFormat> {
         const bool float_types = tic.r_type == ComponentType::FLOAT;
@@ -1270,7 +1274,7 @@ bool KeplerCompute::ProcessOcarinaNetwork(u64 program_id, u64 native_key) {
             return std::nullopt;
         }
     };
-    const auto usable = [](const TICEntry& tic) {
+    const auto shaped = [](const TICEntry& tic) {
         return (tic.texture_type == TextureType::Texture2D ||
                 tic.texture_type == TextureType::Texture2DNoMipmap) &&
                tic.IsBlockLinear() && tic.Depth() == 1 && tic.Address() != 0 &&
@@ -1278,46 +1282,77 @@ bool KeplerCompute::ProcessOcarinaNetwork(u64 program_id, u64 native_key) {
                tic.Height() <= 8192;
     };
     struct Candidate {
+        u32 slot;
         u32 offset;
         TICEntry tic;
     };
     std::vector<Candidate> candidates;
-    const auto& cbuf = launch_description.const_buffer_config[0];
-    const u32 scan = (std::min)(static_cast<u32>(cbuf.size.Value()), 0x400U);
-    for (u32 offset = 0; offset + 4 <= scan; offset += 4) {
-        const auto tic = ComputeImageHandle(offset);
-        if (!tic || !usable(*tic) || !target_format(*tic)) {
+    std::vector<Candidate> others;
+    for (u32 slot = 0; slot < 8; ++slot) {
+        if (((launch_description.const_buffer_enable_mask.Value() >> slot) & 1) == 0) {
             continue;
         }
-        const bool seen = std::ranges::any_of(candidates, [&](const Candidate& c) {
-            return c.tic.Address() == tic->Address() && c.tic.format == tic->format;
-        });
-        if (!seen) {
-            candidates.push_back({offset, *tic});
+        const auto& cbuf = launch_description.const_buffer_config[slot];
+        const GPUVAddr address = (GPUVAddr{cbuf.address_high} << 32) | cbuf.address_low;
+        const u32 scan = (std::min)(static_cast<u32>(cbuf.size.Value()), 0x800U);
+        for (u32 offset = 0; offset + 4 <= scan; offset += 4) {
+            if (!memory_manager.IsFullyMappedRange(address + offset, sizeof(u32))) {
+                continue;
+            }
+            const u32 index = memory_manager.Read<u32>(address + offset) & 0xfffff;
+            if (index == 0 || index > regs.tic.limit ||
+                !memory_manager.IsFullyMappedRange(regs.tic.Address() + u64{index} * sizeof(TICEntry),
+                                                   sizeof(TICEntry))) {
+                continue;
+            }
+            const TICEntry tic = GetTICEntry(index);
+            if (!shaped(tic)) {
+                continue;
+            }
+            auto& list = target_format(tic) ? candidates : others;
+            const bool seen = std::ranges::any_of(list, [&](const Candidate& c) {
+                return c.tic.Address() == tic.Address() && c.tic.format == tic.format;
+            });
+            if (!seen) {
+                list.push_back({slot, offset, tic});
+            }
         }
     }
     const auto describe = [](const Candidate& c) {
-        return fmt::format(" [cb0+{:#x} {:#x} {}x{} format {:#x} type {} mips {}]", c.offset,
-                           c.tic.Address(), c.tic.Width(), c.tic.Height(),
+        return fmt::format(" [cb{}+{:#x} {:#x} {}x{} format {:#x} type {} mips {}]", c.slot,
+                           c.offset, c.tic.Address(), c.tic.Width(), c.tic.Height(),
                            static_cast<u32>(c.tic.format.Value()),
                            static_cast<u32>(c.tic.r_type.Value()), c.tic.max_mip_level.Value());
     };
-    static u32 logged = 0;
-    if (logged < 4) {
-        ++logged;
+    const auto& cb0 = launch_description.const_buffer_config[0];
+    const GPUVAddr cb0_address = (GPUVAddr{cb0.address_high} << 32) | cb0.address_low;
+    const auto cb0_word = [&](u32 offset) -> std::optional<u32> {
+        if (!(launch_description.const_buffer_enable_mask & 1) || cb0.size.Value() < offset + 4 ||
+            !memory_manager.IsFullyMappedRange(cb0_address + offset, sizeof(u32))) {
+            return std::nullopt;
+        }
+        return memory_manager.Read<u32>(cb0_address + offset);
+    };
+    static std::array<u32, 2> logged{};
+    if (logged[key_index] < 3) {
+        ++logged[key_index];
         std::string list;
         for (const auto& c : candidates) {
             list += describe(c);
         }
+        std::string other_list;
+        for (const auto& c : others) {
+            other_list += describe(c);
+        }
         std::string words;
-        const GPUVAddr address = (GPUVAddr{cbuf.address_high} << 32) | cbuf.address_low;
-        for (u32 offset = 0; offset + 4 <= (std::min)(scan, 0x200U); offset += 4) {
-            if (memory_manager.IsFullyMappedRange(address + offset, 4)) {
-                words += fmt::format(" {:08x}", memory_manager.Read<u32>(address + offset));
+        for (u32 offset = 0; offset < 0x100; offset += 4) {
+            if (const auto word = cb0_word(offset)) {
+                words += fmt::format(" {:08x}", *word);
             }
         }
-        LOG_INFO(HW_GPU, "AriseOS Ocarina network {:#018x}: images{} | cb0{}", native_key,
-                 list.empty() ? " none" : list, words);
+        LOG_INFO(HW_GPU, "AriseOS Ocarina network {:#018x}: colour images{} | other images{} | cb0{}",
+                 native_key, list.empty() ? " none" : list,
+                 other_list.empty() ? " none" : other_list, words);
     }
     const Candidate* output = nullptr;
     for (const auto& c : candidates) {
@@ -1327,18 +1362,50 @@ bool KeplerCompute::ProcessOcarinaNetwork(u64 program_id, u64 native_key) {
             output = &c;
         }
     }
+    static std::array<std::optional<TICEntry>, 2> last_output{};
+    static std::array<std::optional<TICEntry>, 2> last_input{};
+    std::optional<TICEntry> out_tic = output ? std::optional{output->tic} : last_output[key_index];
+    if (!out_tic) {
+        return false;
+    }
+    // cb0 words 6 and 7 hold the rendered width and height minus one (1439x809 of a 1920x1080
+    // output at 75% dynamic resolution).
+    u32 render_w = 0;
+    u32 render_h = 0;
+    if (const auto w = cb0_word(0x18), h = cb0_word(0x1c); w && h && *w + 1 >= 256 &&
+        *h + 1 >= 144 && *w + 1 <= out_tic->Width() && *h + 1 <= out_tic->Height()) {
+        render_w = *w + 1;
+        render_h = *h + 1;
+    }
     const Candidate* input = nullptr;
-    if (output != nullptr) {
-        for (const auto& c : candidates) {
-            if (&c == output || c.tic.Address() == output->tic.Address() ||
-                c.tic.Width() > output->tic.Width() || c.tic.Height() > output->tic.Height()) {
-                continue;
-            }
-            if (input == nullptr ||
-                c.tic.Width() * c.tic.Height() > input->tic.Width() * input->tic.Height()) {
-                input = &c;
-            }
+    for (const auto& c : candidates) {
+        if (c.tic.Address() == out_tic->Address() || c.tic.Width() > out_tic->Width() ||
+            c.tic.Height() > out_tic->Height()) {
+            continue;
+        }
+        const auto covers = [&](const TICEntry& tic) {
+            return render_w != 0 && tic.Width() >= render_w && tic.Height() >= render_h;
+        };
+        if (input == nullptr || (covers(c.tic) && !covers(input->tic)) ||
+            (covers(c.tic) == covers(input->tic) &&
+             c.tic.Width() * c.tic.Height() > input->tic.Width() * input->tic.Height())) {
+            input = &c;
+        }
+    }
+    std::optional<TICEntry> in_tic = input ? std::optional{input->tic} : last_input[key_index];
+    static std::array<u64, 2> replaced{};
+    static std::array<u64, 2> native{};
+    const auto count = [&](bool was_replaced) {
+        auto& counter = was_replaced ? replaced[key_index] : native[key_index];
+        ++counter;
+        if ((counter & (counter - 1)) == 0 && counter >= 8) {
+            LOG_INFO(HW_GPU, "AriseOS Ocarina network {:#018x}: {} replaced, {} native",
+                     native_key, replaced[key_index], native[key_index]);
         }
+    };
+    if (!in_tic) {
+        count(false);
+        return false;
     }
     const auto surface = [&](const TICEntry& tic) {
         Fermi2D::Surface result{};
@@ -1354,36 +1421,39 @@ bool KeplerCompute::ProcessOcarinaNetwork(u64 program_id, u64 native_key) {
         result.addr_lower = static_cast<u32>(tic.Address());
         return result;
     };
-    bool done = false;
-    if (output != nullptr && input != nullptr) {
-        const Fermi2D::Config config{
-            .operation = Fermi2D::Operation::SrcCopy,
-            .filter = Fermi2D::Filter::Bilinear,
-            .must_accelerate = true,
-            .dst_x0 = 0,
-            .dst_y0 = 0,
-            .dst_x1 = static_cast<s32>(output->tic.Width()),
-            .dst_y1 = static_cast<s32>(output->tic.Height()),
-            .src_x0 = 0,
-            .src_y0 = 0,
-            .src_x1 = static_cast<s32>(input->tic.Width()),
-            .src_y1 = static_cast<s32>(input->tic.Height()),
-        };
-        done = rasterizer->AccelerateSurfaceCopy(surface(input->tic), surface(output->tic), config);
-    }
-    if (!done) {
+    const bool crop = render_w != 0 && in_tic->Width() >= render_w && in_tic->Height() >= render_h;
+    const Fermi2D::Config config{
+        .operation = Fermi2D::Operation::SrcCopy,
+        .filter = Fermi2D::Filter::Bilinear,
+        .must_accelerate = true,
+        .dst_x0 = 0,
+        .dst_y0 = 0,
+        .dst_x1 = static_cast<s32>(out_tic->Width()),
+        .dst_y1 = static_cast<s32>(out_tic->Height()),
+        .src_x0 = 0,
+        .src_y0 = 0,
+        .src_x1 = static_cast<s32>(crop ? render_w : in_tic->Width()),
+        .src_y1 = static_cast<s32>(crop ? render_h : in_tic->Height()),
+    };
+    if (!rasterizer->AccelerateSurfaceCopy(surface(*in_tic), surface(*out_tic), config)) {
         failed = true;
-        LOG_WARNING(HW_GPU, "AriseOS Ocarina network: no blit (output {}, input {}); the network "
-                            "runs natively",
-                    output ? describe(*output) : std::string{" none"},
-                    input ? describe(*input) : std::string{" none"});
+        LOG_WARNING(HW_GPU, "AriseOS Ocarina network: blit {:#x} {}x{} -> {:#x} {}x{} refused; "
+                            "the network runs natively",
+                    in_tic->Address(), in_tic->Width(), in_tic->Height(), out_tic->Address(),
+                    out_tic->Width(), out_tic->Height());
         return false;
     }
-    static bool announced = false;
-    if (!std::exchange(announced, true)) {
-        LOG_INFO(HW_GPU, "AriseOS Ocarina network replaced: input{} scaled into output{}",
-                 describe(*input), describe(*output));
-    }
+    last_output[key_index] = out_tic;
+    last_input[key_index] = in_tic;
+    static std::array<bool, 2> announced{};
+    if (!std::exchange(announced[key_index], true)) {
+        LOG_INFO(HW_GPU, "AriseOS Ocarina network {:#018x} replaced: {:#x} {}x{} (source {}x{}) "
+                         "scaled into {:#x} {}x{}",
+                 native_key, in_tic->Address(), in_tic->Width(), in_tic->Height(),
+                 config.src_x1, config.src_y1, out_tic->Address(), out_tic->Width(),
+                 out_tic->Height());
+    }
+    count(true);
     return true;
 }
 
-- 
2.43.0

